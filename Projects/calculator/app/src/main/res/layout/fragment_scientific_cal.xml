<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="1">
            
            <TextView
                android:id="@+id/tv_angle_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Deg"
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:padding="8dp"
                android:gravity="start"/>
            
            <ImageView
                android:id="@+id/iv_menu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_more"
                android:contentDescription="@null"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_expression"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom|end"
            android:textSize="28sp"
            android:textColor="#000000"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="top|end"
            android:textSize="20sp"
            android:textColor="#757575"
            android:maxLines="1"
            android:ellipsize="end"/>

    </LinearLayout>

    <GridLayout
        android:id="@+id/button_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6"
        android:columnCount="7"
        android:rowCount="6"
        android:padding="8dp"
        android:background="#F0F0F0"
        android:useDefaultMargins="false">

        <!-- 第一行：( ) 1/x MC M+ M- MR -->
        <android.widget.Button
            android:id="@+id/btn_open"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="("
            android:textSize="14sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_number"/>

        <android.widget.Button
            android:id="@+id/btn_close"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text=")"
            android:textSize="14sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_number"/>

        <android.widget.Button
            android:id="@+id/btn_1x"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="1/x"
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_mc"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="MC"
            android:textSize="11sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_m_plus"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="M+"
            android:textSize="11sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_m_minus"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="M-"
            android:textSize="11sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_mr"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="MR"
            android:textSize="11sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <!-- 第二行：x² x³ xʸ C ÷ × ←(删除) -->
        <android.widget.Button
            android:id="@+id/btn_sq"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="x²"
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_cbrt"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="x³"
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_pow"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="xʸ"
            android:textSize="11sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="C"
            android:textSize="14sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_div"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="÷"
            android:textSize="14sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_mul"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="×"
            android:textSize="14sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_del"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="⌫"
            android:textSize="14sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <!-- 第三行：x! √ ∛x 7 8 9 - -->
        <android.widget.Button
            android:id="@+id/btn_fact"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="x!"
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_sqrt"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="√"
            android:textSize="16sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_yroot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="∛"
            android:textSize="16sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="7"
            android:textSize="16sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_number"/>

        <android.widget.Button
            android:id="@+id/btn_8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="8"
            android:textSize="16sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_number"/>

        <android.widget.Button
            android:id="@+id/btn_9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="9"
            android:textSize="16sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_number"/>

        <android.widget.Button
            android:id="@+id/btn_sub"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="-"
            android:textSize="16sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <!-- 第四行：e ln log 4 5 6 + -->
        <android.widget.Button
            android:id="@+id/btn_exp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="e"
            android:textSize="14sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_ln"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="ln"
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_log"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="log"
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="4"
            android:textSize="16sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_number"/>

        <android.widget.Button
            android:id="@+id/btn_5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="5"
            android:textSize="16sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_number"/>

        <android.widget.Button
            android:id="@+id/btn_6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="6"
            android:textSize="16sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_number"/>

        <android.widget.Button
            android:id="@+id/btn_add"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="+"
            android:textSize="16sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <!-- 第五行：sin cos tan 1 2 3 = -->
        <android.widget.Button
            android:id="@+id/btn_sin"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="sin"
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_cos"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="cos"
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_tan"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="tan"
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="1"
            android:textSize="16sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_number"/>

        <android.widget.Button
            android:id="@+id/btn_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="2"
            android:textSize="16sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_number"/>

        <android.widget.Button
            android:id="@+id/btn_3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="3"
            android:textSize="16sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_number"/>

        <android.widget.Button
            android:id="@+id/btn_equal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_column="6"
            android:layout_row="4"
            android:layout_columnSpan="1"
            android:layout_rowSpan="2"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="="
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_equal"/>

        <!-- 第六行：Inv Rad π % 0 . -->
        <android.widget.Button
            android:id="@+id/btn_inv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="inv"
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_rad"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="rad"
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_pi"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="π"
            android:textSize="16sp"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_operator"/>

        <android.widget.Button
            android:id="@+id/btn_percent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="%"
            android:textSize="16sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_number"/>

        <android.widget.Button
            android:id="@+id/btn_0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="0"
            android:textSize="16sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_number"/>

        <android.widget.Button
            android:id="@+id/btn_dot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="."
            android:textSize="16sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/btn_sci_number"/>

    </GridLayout>

</LinearLayout>