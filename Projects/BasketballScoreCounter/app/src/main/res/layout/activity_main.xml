<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

        <!-- 顶部标题栏 全屏宽度，不会溢出 -->
        <View
            android:id="@+id/view_title_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#00897B"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:layout_marginStart="16dp"
            app:layout_constraintVertical_bias="0.5"
            app:layout_constraintBottom_toBottomOf="@id/view_title_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/view_title_bar"/>

        <!-- 队伍名称 左右均分，左右留边避免贴屏 -->
        <TextView
            android:id="@+id/tv_team_a"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Team A"
            android:textColor="#444444"
            android:textSize="26sp"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintEnd_toStartOf="@id/tv_team_b"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/view_title_bar"/>

        <TextView
            android:id="@+id/tv_team_b"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Team B"
            android:textColor="#444444"
            android:textSize="26sp"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_team_a"
            app:layout_constraintTop_toBottomOf="@id/view_title_bar"/>

        <!-- 分数数字 -->
        <TextView
            android:id="@+id/tv_score_a"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="8"
            android:textColor="#E50040"
            android:textSize="100sp"
            android:gravity="center"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintEnd_toStartOf="@id/tv_score_b"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_team_a"/>

        <TextView
            android:id="@+id/tv_score_b"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="8"
            android:textColor="#00897B"
            android:textSize="100sp"
            android:gravity="center"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_score_a"
            app:layout_constraintTop_toBottomOf="@id/tv_team_b"/>

        <!-- +1 按钮 紫色底色，左右留边不贴屏幕 -->
        <Button
            android:id="@+id/btn_a_plus1"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="+1"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:background="#7952B3"
            android:layout_marginTop="24dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintEnd_toStartOf="@id/btn_b_plus1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_score_a"/>

        <Button
            android:id="@+id/btn_b_plus1"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="+1"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:background="#7952B3"
            android:layout_marginTop="24dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_a_plus1"
            app:layout_constraintTop_toBottomOf="@id/tv_score_b"/>

        <!-- +2 按钮 -->
        <Button
            android:id="@+id/btn_a_plus2"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="+2"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:background="#7952B3"
            android:layout_marginTop="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintEnd_toStartOf="@id/btn_b_plus2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_a_plus1"/>

        <Button
            android:id="@+id/btn_b_plus2"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="+2"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:background="#7952B3"
            android:layout_marginTop="16dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_a_plus2"
            app:layout_constraintTop_toBottomOf="@id/btn_b_plus1"/>

        <!-- 底部撤销、重置按钮 靠底部，不会超出屏幕底部 -->
        <Button
            android:id="@+id/btn_undo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:text="↩"
            android:textSize="26sp"
            android:background="#DDDDDD"
            android:textColor="#333333"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_reset"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_a_plus2"/>

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:text="⟳"
            android:textSize="26sp"
            android:background="#DDDDDD"
            android:textColor="#333333"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_undo"
            app:layout_constraintTop_toBottomOf="@id/btn_b_plus2"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>